# Copy to .env.local (dev) or set in the build environment (production). Read via import.meta.env.
# Vite only exposes VITE_*-prefixed variables to client code, and bakes them in at build time.

# Base URL of breviarium--backend, without a trailing path (e.g. https://api.breviarium.es).
# The Profile tab calls it. Optional in `vite dev`, where it defaults to http://localhost:8000.
# Required for production builds; the backend must list this app's origin(s) in CORS_ORIGINS
# (capacitor://localhost and http://localhost, the Capacitor iOS/Android origins, are already there).
VITE_BACKEND_API_ENDPOINT=http://localhost:8000

# Web OAuth client ID for Google Sign-In on the Profile tab. Leave empty to hide the button.
# This must be the WEB client ID from Google Cloud Console even for the iOS/Android builds -
# @capawesome/capacitor-google-sign-in always uses it as the ID token's audience, which is what
# the backend's GOOGLE_CLIENT_IDS checks. Add this app's origin(s) to its Authorized JavaScript
# origins AND to its Authorized redirect URIs as <origin>/profile (the web build signs in via a
# redirect back to the Profile tab, e.g. http://localhost:5173/profile in dev), and add the ID to
# the backend's GOOGLE_CLIENT_IDS.
#
# iOS additionally needs its OWN (different) client ID, registered natively via GIDClientID and
# the reversed-client-ID URL scheme in ios/App/App/Info.plist. Android needs an Android OAuth
# client registered with the app's package name and SHA-1 signing fingerprint (debug and, for
# Play builds, the app signing key) - that client ID is never passed to the plugin.
VITE_GOOGLE_CLIENT_ID=
